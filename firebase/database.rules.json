{
  "rules": {
    "rooms": {
      "$pin": {
        ".read": "auth != null && data.child('host').val() === auth.uid",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && data.child('host').val() === auth.uid))",
        ".validate": "$pin.matches(/^[0-9]{6}$/) && newData.hasChildren(['host', 'quizId', 'state']) && newData.child('host').val() === (data.exists() ? data.child('host').val() : auth.uid)",
        "host": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
        },
        "hostName": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "quizId": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
        },
        "quizTitle": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "courseId": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "courseName": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "createdAt": {
          ".read": "auth != null",
          ".validate": "newData.isNumber()"
        },
        "state": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($pin).child('host').val() === auth.uid",
          ".validate": "newData.hasChildren(['phase', 'index', 'total'])",
          "phase": {
            ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'question' || newData.val() === 'reveal' || newData.val() === 'end')"
          },
          "index": {
            ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() < 500"
          },
          "total": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 500"
          },
          "startedAt": {
            ".validate": "newData.isNumber()"
          },
          "qkey": {
            ".validate": "newData.isString() && newData.val().length <= 4"
          },
          "duration": {
            ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 300"
          }
        },
        "question": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($pin).child('host').val() === auth.uid",
          ".validate": "newData.hasChildren(['index', 'type', 'text'])",
          "index": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 500"
          },
          "type": {
            ".validate": "newData.isString() && (newData.val() === 'mc' || newData.val() === 'short')"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 5000"
          },
          "image": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          }
        },
        "reveal": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($pin).child('host').val() === auth.uid",
          ".validate": "newData.hasChildren(['index'])",
          "index": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 500"
          },
          "correct": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 300)"
          }
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($pin).child('host').exists()",
            ".validate": "newData.hasChildren(['name', 'username'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
            },
            "username": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            }
          }
        },
        "answers": {
          ".read": "auth != null && root.child('rooms').child($pin).child('host').val() === auth.uid",
          "$i": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('rooms').child($pin).child('players').child(auth.uid).exists() && root.child('rooms').child($pin).child('state/phase').val() === 'question' && root.child('rooms').child($pin).child('state/qkey').val() === $i && now <= root.child('rooms').child($pin).child('state/startedAt').val() + root.child('rooms').child($pin).child('state/duration').val() * 1000 + 2000",
              ".validate": "newData.hasChildren(['a', 't']) && newData.child('t').val() === now && ((newData.child('a').isNumber() && newData.child('a').val() >= 0 && newData.child('a').val() < 8) || (newData.child('a').isString() && newData.child('a').val().length >= 1 && newData.child('a').val().length <= 200))",
              "a": {
                ".validate": "(newData.isNumber() && newData.val() >= 0 && newData.val() < 8) || (newData.isString() && newData.val().length >= 1 && newData.val().length <= 200)"
              },
              "t": {
                ".validate": "newData.isNumber() && newData.val() === now"
              }
            }
          }
        },
        "scores": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($pin).child('host').val() === auth.uid",
          "$uid": {
            ".validate": "newData.hasChildren(['score', 'correctCount', 'streak']) && newData.child('score').isNumber() && newData.child('correctCount').isNumber() && newData.child('streak').isNumber()",
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "correctCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "streak": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "lastCorrect": {
              ".validate": "newData.isBoolean()"
            },
            "lastGain": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "rank": {
              ".validate": "newData.isNumber() && newData.val() >= 1"
            }
          }
        }
      }
    }
  }
}
